---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import ProjectPage from "../../components/ProjectPage.astro";
import { pagesIn, slugOf } from "../../projects";

export const getStaticPaths = (async () => {
    const english: Set<string> = new Set((await pagesIn("en")).map(slugOf));
    return (await pagesIn("ko")).map((project: CollectionEntry<"projects">) => ({
        params: { slug: slugOf(project) },
        props: { project, translated: english.has(slugOf(project)) },
    }));
}) satisfies GetStaticPaths;

interface Props {
    readonly project: CollectionEntry<"projects">;
    readonly translated: boolean;
}

const { project, translated }: Props = Astro.props;
---

<ProjectPage lang="ko" project={project} translated={translated} />
