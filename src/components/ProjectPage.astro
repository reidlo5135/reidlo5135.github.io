---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Mermaid from "./Mermaid.astro";
import Panel from "./Panel.astro";
import type { Lang } from "../i18n";
import { STRINGS, homePath, projectPath } from "../i18n";
import { familyOf, slugOf } from "../projects";

interface Props {
    readonly lang: Lang;
    readonly project: CollectionEntry<"projects">;
    /** Whether the other language has this project too. */
    readonly translated: boolean;
}

const { lang, project, translated }: Props = Astro.props;
const t = STRINGS[lang];
const data = project.data;
const other: Lang = lang === "ko" ? "en" : "ko";
const { Content } = await render(project);
const family: CollectionEntry<"projects">[] = await familyOf(project, lang);
const root: CollectionEntry<"projects"> = family[0] ?? project;
---

<Base
    lang={lang}
    title={`${data.title} — ${t.title}`}
    description={data.summary}
    otherPath={translated ? projectPath(other, slugOf(project)) : homePath(other)}
>
    <Panel>
        <a class="back" href={`${homePath(lang)}#projects`}>{t.back}</a>
        <header>
            <span class="label">{data.kind === "personal" ? t.personal : t.work}</span>
            <h1>{root.data.title}</h1>
            {
                family.length > 1 && (
                    <nav class="tabs" aria-label={root.data.title}>
                        {family.map((page: CollectionEntry<"projects">) => (
                            <a
                                href={projectPath(lang, slugOf(page))}
                                aria-current={page.id === project.id ? "page" : undefined}
                            >
                                {page.data.tab ?? page.data.title}
                            </a>
                        ))}
                    </nav>
                )
            }
            <p class="summary">{data.summary}</p>
            <dl>
                <dt class="label">{t.role}</dt>
                <dd>{data.role}</dd>
                <dt class="label">{t.period}</dt>
                <dd>{data.period}</dd>
                <dt class="label">{t.stack}</dt>
                <dd>
                    <ul class="chips">
                        {data.stack.map((item: string) => <li>{item}</li>)}
                    </ul>
                </dd>
            </dl>
            {
                data.links.length > 0 && (
                    <p class="links">
                        {data.links.map((link: { label: string; href: string }) => <a href={link.href}>{link.label} ↗</a>)}
                    </p>
                )
            }
        </header>
        <div class="body">
            <Content />
        </div>
    </Panel>
    <Mermaid />
</Base>

<style>
    .back {
        font-size: 14px;
        text-decoration: none;
    }

    h1 {
        margin: 12px 0 8px;
        font-size: clamp(28px, 4.5vw, 38px);
    }

    .tabs {
        display: flex;
        gap: 4px;
        margin: 4px 0 18px;
        padding: 4px;
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface-2);
        scrollbar-width: none;
    }

    .tabs a {
        flex: none;
        padding: 6px 14px;
        border-radius: 7px;
        color: var(--muted);
        font-size: 14px;
        text-decoration: none;
    }

    .tabs a:hover {
        color: var(--text);
    }

    .tabs a[aria-current="page"] {
        background: var(--surface);
        color: var(--brand);
        box-shadow: 0 0 0 1px var(--border);
    }

    .summary {
        margin: 0 0 24px;
        color: var(--muted);
        font-size: 18px;
    }

    dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 8px 20px;
        margin: 0;
        padding: 18px 20px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface-2);
    }

    dd {
        margin: 0;
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }

    .body {
        margin-top: 40px;
    }

    .body :global(h2) {
        margin-top: 40px;
        font-size: 22px;
    }

    .body :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        border: 1px solid var(--border);
        border-radius: var(--radius);
    }

    .body :global(figure:not(.diagram)) {
        margin: 20px 0 28px;
    }

    .body :global(figcaption) {
        margin-top: 10px;
        color: var(--muted);
        font-size: 14px;
    }

    /* Wide tables scroll inside the page instead of pushing it sideways. */
    .body :global(table) {
        display: block;
        max-width: 100%;
        margin: 16px 0 24px;
        overflow-x: auto;
        border-collapse: collapse;
        font-size: 14px;
    }

    .body :global(th),
    .body :global(td) {
        padding: 8px 12px;
        border-bottom: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
    }

    .body :global(th) {
        background: var(--surface-2);
        color: var(--muted);
        font-weight: 600;
        white-space: nowrap;
    }

    .body :global(h3) {
        margin-top: 28px;
        font-size: 17px;
    }

    .body :global(blockquote) {
        margin: 16px 0;
        padding: 4px 16px;
        border-left: 3px solid var(--brand);
        color: var(--muted);
    }

    .body :global(code) {
        padding: 1px 5px;
        border-radius: 4px;
        background: var(--surface);
        font-size: 0.9em;
    }
</style>
