---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import type { Lang } from "../i18n";
import { PROFILE } from "../profile";

interface Props {
    readonly lang: Lang;
    readonly title: string;
    readonly description: string;
    /** The same page in the other language. */
    readonly otherPath: string;
}

const { lang, title, description, otherPath }: Props = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={PROFILE.avatar} />
        <link rel="alternate" hreflang={lang === "ko" ? "en" : "ko"} href={otherPath} />
    </head>
    <body>
        <div class="shell">
            <div class="side">
                <Sidebar lang={lang} otherPath={otherPath} />
            </div>
            <main>
                <slot />
                <footer class="label">
                    <span>© {new Date().getFullYear()} {PROFILE.name[lang]}</span>
                    <span>Astro · GitHub Pages</span>
                </footer>
            </main>
        </div>
    </body>
</html>

<style>
    .shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 24px;
        width: min(100% - 32px, 1200px);
        margin-inline: auto;
        padding-block: 16px 0;
    }

    main {
        display: flex;
        flex-direction: column;
        gap: 24px;
        min-width: 0;
    }

    footer {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 24px 4px 40px;
    }

    @media (min-width: 1024px) {
        .shell {
            grid-template-columns: 300px minmax(0, 1fr);
            gap: 32px;
            padding-block: 32px 0;
        }

        /* The profile card stays in view while the page scrolls. */
        .side {
            position: sticky;
            top: 32px;
            align-self: start;
            height: calc(100vh - 64px);
        }

        .side :global(.sidebar) {
            height: 100%;
            overflow-y: auto;
        }
    }
</style>
